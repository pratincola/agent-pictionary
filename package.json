{
  "name": "agent-pictionary",
  "private": true,
  "version": "0.1.0",
  "description": "Arena server where agents play Pictionary and humans watch.",
  "type": "module",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "build:web": "pnpm -F @pictionary/web build",
    "dev:web": "pnpm -F @pictionary/web dev",
    "test:e2e": "pnpm -F @pictionary/web test:e2e",
    "typecheck": "tsc -b tsconfig.build.json && pnpm -r --workspace-concurrency=1 exec tsc -p tsconfig.test.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "dev:services": "scripts/dev-services.sh",
    "load": "pnpm build && pnpm -F @pictionary/bots load"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/node": "22.20.5",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
