# Copy to .env for local runs. Every variable the server reads is listed here.

# Postgres connection string (scripts/dev-services.sh starts one on 5433).
DATABASE_URL=postgres://postgres@localhost:5433/pictionary_test

# Redis: room directory (room:{code} -> node), spectator fan-out (pub/sub),
# room snapshots for restart recovery, REST rate-limit counters. Leave UNSET
# for a single node with in-memory equivalents (what the tests use).
REDIS_URL=redis://localhost:6380

# Stable node identity. Rooms are pinned to it in Redis and restored from
# their snapshot when a node with the same NODE_ID restarts. Default: node-<pid>
# (fine for one node; set it explicitly when running several or restarting).
NODE_ID=node-1

# Directory entry TTL in ms; the node renews every TTL/3. A node that stops
# heartbeating loses its rooms after this long.
ROOM_TTL_MS=15000

# REST rate limits (per client IP per minute; canvas.png is per session per second).
RATE_LIMIT_AGENTS_PER_MIN=60
RATE_LIMIT_ROOMS_PER_MIN=30
RATE_LIMIT_CANVAS_PER_SEC=1

# HTTP + WebSocket listen address.
HOST=0.0.0.0
PORT=8080

# Public base URL used to build wsUrl in session responses (no trailing slash).
# Example: wss://arena.example.com -> wsUrl = wss://arena.example.com/ws?token=...
PUBLIC_WS_URL=ws://localhost:8080

# Public REST base other nodes redirect players to (307). Default: PUBLIC_WS_URL
# with ws->http, else the listen address.
# PUBLIC_REST_URL=http://localhost:8080

# Secret used to sign session tokens (HMAC-SHA256). Use 32+ random bytes.
SESSION_SECRET=change-me-to-a-long-random-string

# --- apps/web (Vite) -----------------------------------------------------
# Where the Vite dev/preview proxy forwards /api/v1/* (REST, prefix stripped)
# and /ws. Build-time only; the browser always talks to its own origin.
VITE_API_BASE=http://localhost:8080
# Optional overrides baked into the bundle: REST mount path the browser calls
# (default /api/v1) and an absolute WebSocket origin (default: page origin).
# VITE_API_PATH=/api/v1
# VITE_WS_BASE=wss://arena.example.com

# Bearer token for /admin/* routes (entitlement grants in MVP).
ADMIN_TOKEN=change-me-admin

# pino log level: trace|debug|info|warn|error|fatal|silent
LOG_LEVEL=info
