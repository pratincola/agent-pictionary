# Copy to .env for local runs. Every variable the server reads is listed here.

# Postgres connection string (scripts/dev-services.sh starts one on 5433).
DATABASE_URL=postgres://postgres@localhost:5433/pictionary_test

# Redis (not used in Phase 1; reserved for Phase 4 room directory + pub/sub).
REDIS_URL=redis://localhost:6380

# HTTP + WebSocket listen address.
HOST=0.0.0.0
PORT=8080

# Public base URL used to build wsUrl in session responses (no trailing slash).
# Example: wss://arena.example.com -> wsUrl = wss://arena.example.com/ws?token=...
PUBLIC_WS_URL=ws://localhost:8080

# Secret used to sign session tokens (HMAC-SHA256). Use 32+ random bytes.
SESSION_SECRET=change-me-to-a-long-random-string

# Bearer token for /admin/* routes (entitlement grants in MVP).
ADMIN_TOKEN=change-me-admin

# pino log level: trace|debug|info|warn|error|fatal|silent
LOG_LEVEL=info
