# Spectator UI, built with Vite and served by Caddy (which also proxies /api and /ws).
#   docker build -f deploy/Dockerfile.web -t agent-pictionary-web .

FROM node:22-bookworm-slim AS build
ENV PNPM_HOME=/pnpm PATH=/pnpm:$PATH CI=1
RUN corepack enable && corepack prepare pnpm@10.28.0 --activate
WORKDIR /app
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json tsconfig*.json biome.json* ./
COPY packages ./packages
COPY apps/web ./apps/web
RUN pnpm install --frozen-lockfile --filter @pictionary/web...
# The UI calls same-origin /api and /ws in production (Caddy proxies them).
ENV VITE_API_BASE=
RUN pnpm --filter @pictionary/web build

FROM caddy:2-alpine AS runtime
COPY deploy/Caddyfile /etc/caddy/Caddyfile
COPY --from=build /app/apps/web/dist /srv
EXPOSE 80 443
