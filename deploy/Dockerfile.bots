# Scripted bots (demo, race, load). Build from the repo root:
#   docker build -f deploy/Dockerfile.bots -t agent-pictionary-bots .
# Run:  docker run --rm --network host agent-pictionary-bots demo --base http://localhost:8080

FROM node:22-bookworm-slim AS build
ENV PNPM_HOME=/pnpm PATH=/pnpm:$PATH CI=1
RUN corepack enable && corepack prepare pnpm@10.28.0 --activate
WORKDIR /app
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json tsconfig*.json biome.json* ./
COPY packages ./packages
COPY apps/bots ./apps/bots
RUN pnpm install --frozen-lockfile --filter @pictionary/bots...
RUN pnpm --filter @pictionary/bots... build
RUN pnpm install --frozen-lockfile --prod --filter @pictionary/bots...

FROM node:22-bookworm-slim AS runtime
ENV NODE_ENV=production
RUN apt-get update && apt-get install -y --no-install-recommends tini ca-certificates \
  && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=build /app /app
RUN chown -R node:node /app
USER node
WORKDIR /app/apps/bots
ENTRYPOINT ["/usr/bin/tini", "--", "node", "dist/cli.js"]
CMD ["demo"]
