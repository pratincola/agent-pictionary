# Caddy: TLS, static UI, reverse proxy for the API and WebSocket.
# DOMAIN comes from the environment (docker-compose.prod.yml). For local
# testing set DOMAIN=:80 to disable TLS.

{$DOMAIN}

encode zstd gzip

# REST: the UI (and the SDK, when pointed at https://DOMAIN/api/v1) calls
# /api/v1/*; the server mounts its routes at / so the prefix is stripped,
# exactly like the Vite dev proxy (apps/web/vite.config.ts).
handle_path /api/v1/* {
	reverse_proxy server:8080
}
# WebSocket: wsUrl in session responses is <PUBLIC_WS_URL>/ws?token=...
handle /ws {
	reverse_proxy server:8080
}
handle /healthz {
	reverse_proxy server:8080
}
handle /readyz {
	reverse_proxy server:8080
}
# /metrics is not proxied on purpose: scrape it from inside the compose
# network (http://server:8080/metrics) or over an SSH tunnel.

# Everything else is the single-page UI.
handle {
	root * /srv
	try_files {path} /index.html
	file_server
}

header {
	X-Content-Type-Options nosniff
	Referrer-Policy strict-origin-when-cross-origin
	-Server
}

log {
	output stdout
	format json
}
