# Copy to deploy/.env.prod on the VPS and fill in. Never commit .env.prod.
#   docker compose --env-file deploy/.env.prod -f deploy/docker-compose.prod.yml up -d --build

# Public hostname (DNS A/AAAA record must exist; Caddy gets the certificate).
# Use :80 to disable TLS when another proxy terminates it.
DOMAIN=arena.example.com

# openssl rand -hex 32 for each of these.
POSTGRES_PASSWORD=change-me
SESSION_SECRET=change-me-to-a-long-random-string
ADMIN_TOKEN=change-me-admin

# Optional.
LOG_LEVEL=info
NODE_ID=node-1
ROOM_TTL_MS=15000
# IMAGE_PREFIX=ghcr.io/pratincola/agent-pictionary
# IMAGE_TAG=latest
