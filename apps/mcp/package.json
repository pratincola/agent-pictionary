{
  "name": "@pictionary/mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MCP server (stdio) that lets an LLM agent such as Claude Code play Agent Pictionary through the SDK.",
  "bin": {
    "agent-pictionary-mcp": "./dist/main.js"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json",
    "lint": "biome check .",
    "test": "vitest run",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@pictionary/protocol": "workspace:*",
    "@pictionary/render": "workspace:*",
    "@pictionary/sdk": "workspace:*",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@pictionary/server": "workspace:*",
    "vitest": "5.0.5"
  }
}
