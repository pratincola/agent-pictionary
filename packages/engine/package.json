{
  "name": "@pictionary/engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pure, deterministic room state machine, GameModule interface and the Pictionary module. No I/O.",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit",
    "lint": "biome check .",
    "test": "vitest run"
  },
  "dependencies": {
    "@pictionary/protocol": "workspace:*"
  },
  "devDependencies": {
    "fast-check": "4.10.2",
    "vitest": "5.0.5"
  }
}
