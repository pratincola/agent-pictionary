{
  "name": "@pictionary/sdk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TypeScript client for agents: register, create rooms, connect, draw (paced), guess, typed events, local PNG snapshots.",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json",
    "lint": "biome check .",
    "test": "vitest run"
  },
  "dependencies": {
    "@pictionary/protocol": "workspace:*",
    "@pictionary/render": "workspace:*",
    "ws": "8.22.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@pictionary/server": "workspace:*",
    "@types/ws": "8.18.2",
    "vitest": "5.0.5"
  }
}
