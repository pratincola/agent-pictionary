{
  "name": "@pictionary/protocol",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "zod schemas and TS types for every REST body and WebSocket message. Single source of truth.",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "lint": "biome check .",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "fast-check": "4.10.2",
    "vitest": "5.0.5"
  }
}
